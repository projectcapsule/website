{{- $events := .Site.Data.events.events | default (slice) -}}
{{- $htmlOutput := .OutputFormats.Get "HTML" -}}
{{- $rssOutput := .OutputFormats.Get "RSS" -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>\n" | safeHTML -}}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>Project Capsule Events</title>
    <link>{{ $htmlOutput.Permalink }}</link>
    <description>Project Capsule community events and appearances.</description>
    <language>{{ .Site.Language.LanguageCode | default "en" }}</language>
    <lastBuildDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
    <atom:link href="{{ $rssOutput.Permalink }}" rel="self" type="application/rss+xml" />
    {{- range sort $events "start" "asc" }}
      {{- $start := time.AsTime .start -}}
      {{- $endValue := .start -}}
      {{- with .end }}{{ $endValue = . }}{{ end -}}
      {{- $end := time.AsTime $endValue -}}
      {{- $dateText := time.Format "2 January 2006" $start -}}
      {{- if ne .start $endValue -}}
        {{- $dateText = printf "%s–%s" (time.Format "2 January 2006" $start) (time.Format "2 January 2006" $end) -}}
      {{- end -}}
      {{- $description := printf "Event date: %s. %s" $dateText .description -}}
      {{- with .details }}
        {{- $description = printf "%s %s" $description (delimit . " ") -}}
      {{- end }}
      {{- $title := .title -}}
      {{- with .flag }}{{ $title = printf "%s %s" $title . }}{{ end -}}
    <item>
      <title>{{ $title | transform.XMLEscape }}</title>
      <link>{{ .url }}</link>
      <guid isPermaLink="false">{{ printf "%s#event-%s" $htmlOutput.Permalink .id }}</guid>
      <pubDate>{{ (time.AsTime (.published | default .start)).Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <description>{{ $description | transform.XMLEscape }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
